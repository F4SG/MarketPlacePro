@model MarketPlacePro.Models.DetalleCarrito

@{
    ViewData["Title"] = "Crear detalle de carrito";
}

<h1>Crear detalle de carrito</h1>

<h4>Detalle del carrito</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" min="1" max="2147483647" step="1" required />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CarritoId" class="control-label">Carrito</label>
                <select asp-for="CarritoId" asp-items="ViewBag.CarritoId" class="form-control">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="CarritoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductoId" class="control-label">Producto</label>
                <select asp-for="ProductoId" asp-items="ViewBag.ProductoId" class="form-control">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="ProductoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    @if (Model != null && Model.CarritoId > 0)
            {
                <a asp-controller="Carritos" asp-action="Details" asp-route-id="@Model.CarritoId" class="btn btn-outline-secondary">Volver al carrito</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
