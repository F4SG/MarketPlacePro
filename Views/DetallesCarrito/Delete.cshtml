@model MarketPlacePro.Models.DetalleCarrito

@{
    ViewData["Title"] = "Eliminar detalle de carrito";
}

<h1>Eliminar detalle de carrito</h1>

<h3>¿Confirmas que deseas eliminar este detalle de carrito?</h3>
<div>
    <h4>Detalle del carrito</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cantidad)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cantidad)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaAgregado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaAgregado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Carrito)
        </dt>
        <dd class = "col-sm-10">
            @Model.Carrito.Usuario.Nombre
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Producto)
        </dt>
        <dd class = "col-sm-10">
            @Model.Producto.Nombre
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        @if (Model != null && Model.CarritoId > 0)
            {
                <a asp-controller="Carritos" asp-action="Details" asp-route-id="@Model.CarritoId" class="btn btn-outline-secondary">Volver al carrito</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            }
    </form>
</div>
