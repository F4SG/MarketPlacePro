
@model IEnumerable<MarketPlacePro.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar pago</a>
</p>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Método</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Referencia</th>
            <th>Fecha de pago</th>
            <th>Número de pedido</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Metodo</td>
                <td>@item.Monto.ToString("N2")</td>
                <td><span class="status-badge status-@item.Estado">@item.Estado.Replace("_", " ")</span></td>
                <td>@item.Referencia</td>
                <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Pedido.NumeroPedido</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
