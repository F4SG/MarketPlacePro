@model MarketPlacePro.Models.Pago

@{
    ViewData["Title"] = "Registrar pago";
}

<h1>Registrar pago</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Metodo" class="control-label">Método de pago</label>
                <input asp-for="Metodo" class="form-control" />
                <span asp-validation-for="Metodo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Monto" class="control-label">Monto</label>
                <input asp-for="Monto" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Estado" class="control-label">Estado</label>
                <select asp-for="Estado" class="form-control">
                    <option value="pendiente">Pendiente</option>
                    <option value="completado">Completado</option>
                    <option value="rechazado">Rechazado</option>
                    <option value="reembolsado">Reembolsado</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Referencia" class="control-label">Referencia</label>
                <input asp-for="Referencia" class="form-control" />
                <span asp-validation-for="Referencia" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaPago" class="control-label">Fecha de pago</label>
                <input asp-for="FechaPago" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PedidoId" class="control-label">Pedido</label>
                <select asp-for="PedidoId" class="form-control" asp-items="ViewBag.PedidoId">
                    <option value="">Seleccione un pedido</option>
                </select>
                <span asp-validation-for="PedidoId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registrar pago</button>
            @if (Model != null && Model.PedidoId > 0)
            {
                <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@Model.PedidoId" class="btn btn-outline-secondary">Volver al pedido</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            }
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
