@model MarketPlacePro.Models.CobroViewModel
@{ ViewData["Title"] = "Confirmar cobro"; }
<div class="eyebrow mb-2">Último paso · Cobro</div>
<h1>Confirmar cobro</h1>
<p>Pedido <strong>@Model.NumeroPedido</strong> · @Model.Comprador</p>
<div class="alert alert-info">Este es un registro manual. Confirma el cobro cuando hayas recibido el efectivo o comprobado el abono en tu cuenta.</div>
<div class="row"><div class="col-lg-7">
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="PedidoId" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="border rounded-3 p-3 mb-4"><span>Total a cobrar</span><strong class="d-block fs-3">Bs @Model.Total.ToString("F2")</strong><span class="text-muted">Pago completo, sin abonos parciales.</span></div>
        <div class="mb-3"><label asp-for="Metodo" class="form-label">Método de pago</label>
            <select asp-for="Metodo" class="form-select" id="metodo-cobro">
                <option value="efectivo">Efectivo</option><option value="transferencia">Transferencia bancaria</option><option value="qr">QR</option>
            </select><span asp-validation-for="Metodo" class="text-danger"></span>
        </div>
        <div class="mb-3"><label asp-for="Referencia" class="form-label">Referencia de la operación</label>
            <input asp-for="Referencia" class="form-control" maxlength="255" id="referencia-cobro" />
            <div class="form-text">Obligatoria para transferencia y QR. En efectivo es opcional.</div><span asp-validation-for="Referencia" class="text-danger"></span>
        </div>
        <div class="form-check mb-4"><input asp-for="ConfirmarRecepcion" class="form-check-input" required />
            <label asp-for="ConfirmarRecepcion" class="form-check-label">Confirmo que recibí o verifiqué el dinero.</label>
            <span asp-validation-for="ConfirmarRecepcion" class="text-danger d-block"></span>
        </div>
        <p>Al confirmar se completará el pedido y se descontará el stock. Si faltan existencias, no se guardará el cobro.</p>
        <button type="submit" class="btn btn-primary">Confirmar cobro y finalizar venta</button>
        <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@Model.PedidoId" class="btn btn-outline-secondary">Volver al pedido</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
