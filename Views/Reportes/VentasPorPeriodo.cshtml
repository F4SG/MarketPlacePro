@model MarketPlacePro.Models.ReporteVentasViewModel
@{
    ViewData["Title"] = "Ventas por período";
}
<h1>Ventas por período</h1>
<p>Por defecto se muestran ventas con pago confirmado, según la fecha del cobro. Los demás estados usan la fecha del pedido y representan importes de pedidos, no dinero cobrado.</p>
<p>Fechas en horario de Bolivia (UTC-4). El período incluye ambos días completos.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label asp-for="Desde">Desde</label>
        <input asp-for="Desde" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="Hasta">Hasta</label>
        <input asp-for="Hasta" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="Estado">Estado</label>
        <select asp-for="Estado" class="form-control">
            <option value="completada" selected="@(Model.Estado == "completada" ? "selected" : null)">Completada</option>
            <option value="pendiente" selected="@(Model.Estado == "pendiente" ? "selected" : null)">Pendiente</option>
            <option value="en_proceso" selected="@(Model.Estado == "en_proceso" ? "selected" : null)">En proceso</option>
            <option value="cancelada" selected="@(Model.Estado == "cancelada" ? "selected" : null)">Cancelada</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

@if (ViewData.ModelState.IsValid)
{
@if (Model.Filas.Count == 0)
{
    <p class="alert alert-info">No hay ventas que coincidan con los filtros.</p>
}
<table class="table table-striped">
    <thead>
        <tr><th>Código de producto</th><th>Producto</th><th>Categoría</th><th>Unidades</th><th>Monto total</th></tr>
    </thead>
    <tbody>
    @foreach (var fila in Model.Filas)
    {
        <tr>
            <td>@fila.ProductoId</td>
            <td>@fila.Producto</td>
            <td>@fila.Categoria</td>
            <td>@fila.CantidadVendida</td>
            <td>Bs @fila.MontoTotal.ToString("F2")</td>
        </tr>
    }
    </tbody>
</table>

<div class="alert alert-info">
    Pedidos en el período: <strong>@Model.TotalPedidos</strong> —
    Monto total: <strong>Bs @Model.MontoTotal.ToString("F2")</strong> —
    Producto con más unidades: <strong>@(Model.ProductoMasVendido ?? "—")</strong>
</div>

}
