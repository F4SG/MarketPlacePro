@model IEnumerable<MarketPlacePro.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear pedido</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Número de pedido</th>
                <th>Subtotal</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Fecha del pedido</th>
                <th>Comprador</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NumeroPedido</td>
                    <td>@item.Subtotal</td>
                    <td>@item.Total</td>
                    <td>@item.Estado</td>
                    <td>@item.FechaPedido</td>
                    <td>@(item.Comprador?.Nombre ?? "Sin comprador")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
