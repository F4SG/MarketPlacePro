@model IEnumerable<MarketPlacePro.Models.DetallePedido>

@{
    ViewData["Title"] = "Detalles de pedidos";
}

<h1>Detalles de pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear detalle</a>
</p>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Número de pedido</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreProducto</td>
                <td>@item.PrecioUnitario.ToString("N2")</td>
                <td>@item.Cantidad</td>
                <td>@item.Subtotal.ToString("N2")</td>
                <td>@item.Pedido.NumeroPedido</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
