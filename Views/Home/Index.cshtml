@{
    ViewData["Title"] = "Inicio";
}

<h1>MarketPlacePro</h1>
<p class="lead">Gestiona usuarios, productos y compras, y consulta los reportes del marketplace.</p>

<div class="row g-4 mt-2">
    <section class="col-md-4" aria-labelledby="titulo-catalogo">
        <h2 id="titulo-catalogo" class="h4">Usuarios y catálogo</h2>
        <p>Consulta y administra los usuarios, las categorías y los productos.</p>
        <ul>
            <li><a asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
            <li><a asp-controller="Categorias" asp-action="Index">Categorías</a></li>
            <li><a asp-controller="Productos" asp-action="Index">Productos</a></li>
        </ul>
    </section>
    <section class="col-md-4" aria-labelledby="titulo-compras">
        <h2 id="titulo-compras" class="h4">Compras</h2>
        <p>Administra los carritos, los pedidos, sus detalles y los pagos.</p>
        <ul>
            <li><a asp-controller="Carritos" asp-action="Index">Carritos</a></li>
            <li><a asp-controller="DetallesCarrito" asp-action="Index">Detalles del carrito</a></li>
            <li><a asp-controller="Pedidos" asp-action="Index">Pedidos</a></li>
            <li><a asp-controller="DetallePedidos" asp-action="Index">Detalles de pedidos</a></li>
            <li><a asp-controller="Pagos" asp-action="Index">Pagos</a></li>
        </ul>
    </section>
    <section class="col-md-4" aria-labelledby="titulo-reportes">
        <h2 id="titulo-reportes" class="h4">Reportes</h2>
        <p>Consulta las ventas por período y los productos con pocas existencias.</p>
        <ul>
            <li><a asp-controller="Reportes" asp-action="VentasPorPeriodo">Ventas por período</a></li>
            <li><a asp-controller="Reportes" asp-action="ProductosBajoStock">Productos con bajo stock</a></li>
        </ul>
    </section>
</div>
