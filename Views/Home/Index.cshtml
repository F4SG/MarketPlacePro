@{ ViewData["Title"] = "Inicio"; }
<section class="welcome mb-4">
    <div class="eyebrow mb-2">Panel de gestión</div>
    <h1>Tu marketplace, paso a paso.</h1>
    <p class="mb-4">Administra el catálogo, organiza las compras y consulta tus ventas desde un solo lugar.</p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Carritos" asp-action="Index" class="btn btn-primary">Gestionar carritos</a>
        <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-primary">Ver pedidos</a>
    </div>
</section>
<h2 class="h5 mb-2">Prepara tu catálogo</h2>
<p class="text-muted">Registra los usuarios y las categorías antes de publicar productos con un vendedor.</p>
<div class="row g-3 mb-4">
    <div class="col-md-4"><section class="module-card">
        <span class="eyebrow">Usuarios</span><h2>Compradores y vendedores</h2>
        <p>Administra los datos de las personas y sus tiendas.</p>
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-primary align-self-start">Ver usuarios</a>
    </section></div>
    <div class="col-md-4"><section class="module-card">
        <span class="eyebrow">Categorías</span><h2>Un catálogo ordenado</h2>
        <p>Organiza los productos por categorías para encontrarlos fácilmente.</p>
        <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-primary align-self-start">Ver categorías</a>
    </section></div>
    <div class="col-md-4"><section class="module-card">
        <span class="eyebrow">Productos</span><h2>Precios y existencias</h2>
        <p>Publica productos, asigna vendedores y revisa las unidades disponibles.</p>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary align-self-start">Ver productos</a>
    </section></div>
</div>
<h2 class="h5 mb-2">Gestiona una compra</h2>
<p class="text-muted">Agrega productos al carrito, confirma el pedido y registra su pago.</p>
<div class="row g-3 mb-4">
    <div class="col-md-4"><section class="module-card">
        <span class="step-number">1</span><h2>Organiza el carrito</h2>
        <p>Abre el carrito del usuario y agrega productos desde su propia pantalla.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Carritos" asp-action="Index" class="btn btn-primary">Carritos</a>
            <a asp-controller="DetallesCarrito" asp-action="Index" class="btn btn-outline-secondary">Sus productos</a>
        </div>
    </section></div>
    <div class="col-md-4"><section class="module-card">
        <span class="step-number">2</span><h2>Registra el pedido</h2>
        <p>Confirma el carrito para crear un pedido con sus productos y precios actuales.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-primary">Pedidos</a>
            <a asp-controller="DetallePedidos" asp-action="Index" class="btn btn-outline-secondary">Sus productos</a>
        </div>
    </section></div>
    <div class="col-md-4"><section class="module-card">
        <span class="step-number">3</span><h2>Confirma el cobro</h2>
        <p>Selecciona el método y confirma el dinero recibido para completar la venta y actualizar el stock.</p>
        <a asp-controller="Pagos" asp-action="Index" class="btn btn-primary align-self-start">Pagos</a>
    </section></div>
</div>
<section class="module-card">
    <h2 class="mt-0">Revisa los resultados</h2>
    <p>Consulta los pedidos por período o identifica productos activos con pocas existencias.</p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Reportes" asp-action="VentasPorPeriodo" class="btn btn-outline-primary">Ventas por período</a>
        <a asp-controller="Reportes" asp-action="ProductosBajoStock" class="btn btn-outline-primary">Productos con bajo stock</a>
    </div>
</section>
