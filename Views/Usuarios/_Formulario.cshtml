@model MarketPlacePro.Models.Usuario
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" maxlength="255" required /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Correo" class="form-label">Correo</label><input asp-for="Correo" type="email" class="form-control" maxlength="255" required /><span asp-validation-for="Correo" class="text-danger"></span></div>
<div class="mb-3">
    <label asp-for="Contrasena" class="form-label">Contraseña</label>
    <input asp-for="Contrasena" type="password" value="" class="form-control" maxlength="255" autocomplete="new-password" />
    @if (Model.Id != 0) { <div class="form-text">Déjala vacía para conservar la contraseña actual.</div> }
    <span asp-validation-for="Contrasena" class="text-danger"></span>
</div>
<div class="mb-3"><label asp-for="Ciudad" class="form-label">Ciudad</label><input asp-for="Ciudad" class="form-control" maxlength="255" /><span asp-validation-for="Ciudad" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" type="tel" class="form-control" maxlength="50" /><span asp-validation-for="Telefono" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="FechaRegistro" class="form-label">Fecha de registro</label><input asp-for="FechaRegistro" type="datetime-local" class="form-control" /><span asp-validation-for="FechaRegistro" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Rol" class="form-label">Rol</label><select asp-for="Rol" class="form-select"><option value="comprador">Comprador</option><option value="vendedor">Vendedor</option><option value="admin">Administrador</option></select><span asp-validation-for="Rol" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="NombreTienda" class="form-label">Nombre de la tienda</label><input asp-for="NombreTienda" class="form-control" maxlength="255" /><span asp-validation-for="NombreTienda" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DescripcionTienda" class="form-label">Descripción de la tienda</label><textarea asp-for="DescripcionTienda" class="form-control" maxlength="1000" rows="3"></textarea><span asp-validation-for="DescripcionTienda" class="text-danger"></span></div>
