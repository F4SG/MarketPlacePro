@model MarketPlacePro.Models.Usuario
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" maxlength="255" required /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Correo" class="form-label">Correo</label><input asp-for="Correo" type="email" class="form-control" maxlength="255" required /><span asp-validation-for="Correo" class="text-danger"></span></div>
<div class="mb-3">
    <label asp-for="Contrasena" class="form-label">Contraseña</label>
    <input asp-for="Contrasena" type="password" value="" class="form-control" maxlength="255" minlength="8" required="@(Model.Id == 0)" autocomplete="new-password" />
    <div class="form-text">Usa al menos 8 caracteres.</div>
    @if (Model.Id != 0) { <div class="form-text">Déjala vacía para conservar la contraseña actual.</div> }
    <span asp-validation-for="Contrasena" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Ciudad" class="form-label">Ciudad</label>
    <select asp-for="Ciudad" class="form-select" aria-describedby="ayuda-ciudad">
        <option value="">Sin especificar</option>
        @if (!string.IsNullOrWhiteSpace(Model.Ciudad) && !CiudadesBolivia.Disponibles.Contains(Model.Ciudad))
        {
            <option value="@Model.Ciudad">@Model.Ciudad (elige una ciudad disponible)</option>
        }
        @foreach (var ciudad in CiudadesBolivia.Disponibles)
        {
            <option value="@ciudad">@ciudad</option>
        }
    </select>
    <div id="ayuda-ciudad" class="form-text">Capitales departamentales de Bolivia y El Alto.</div>
    <span asp-validation-for="Ciudad" class="text-danger"></span>
</div>
<div class="mb-3"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" type="tel" class="form-control" maxlength="13" placeholder="71234567 o +591 71234567" /><span asp-validation-for="Telefono" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Rol" class="form-label">Rol</label><select asp-for="Rol" class="form-select"><option value="comprador">Comprador</option><option value="vendedor">Vendedor</option><option value="admin">Administrador</option></select><span asp-validation-for="Rol" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="NombreTienda" class="form-label">Nombre de la tienda (obligatorio para vendedores)</label><input asp-for="NombreTienda" class="form-control" maxlength="255" /><span asp-validation-for="NombreTienda" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DescripcionTienda" class="form-label">Descripción de la tienda</label><textarea asp-for="DescripcionTienda" class="form-control" maxlength="1000" rows="3"></textarea><span asp-validation-for="DescripcionTienda" class="text-danger"></span></div>
