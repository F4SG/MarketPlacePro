@model MarketPlacePro.Models.Carrito
@{ ViewData["Title"] = "Carrito de " + Model.Usuario.Nombre; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><div class="eyebrow mb-2">Paso 1 · Carrito</div><h1>@ViewData["Title"]</h1>
        <span class="status-badge status-@Model.Estado">@Model.Estado.Replace("_", " ")</span>
    </div>
    <a asp-controller="DetallesCarrito" asp-action="Create" asp-route-carritoId="@Model.Id" class="btn btn-primary">Agregar producto</a>
</div>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (!Model.Detalles.Any())
{
    <div class="alert alert-info">El carrito está vacío. Agrega productos para preparar un pedido.</div>
}
else
{
    <div class="table-responsive"><table class="table">
        <thead><tr><th>Producto</th><th>Estado</th><th class="text-end">Precio actual</th><th class="text-end">Cantidad</th><th class="text-end">Importe</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var detalle in Model.Detalles.OrderBy(d => d.Id))
        {
            <tr><td>@detalle.Producto.Nombre</td><td><span class="status-badge status-@detalle.Producto.Estado">@detalle.Producto.Estado</span></td>
                <td class="text-end text-nowrap">Bs @detalle.Producto.Precio.ToString("F2")</td><td class="text-end">@detalle.Cantidad</td>
                <td class="text-end text-nowrap">Bs @((detalle.Producto.Precio * detalle.Cantidad).ToString("F2"))</td>
                <td><a asp-controller="DetallesCarrito" asp-action="Edit" asp-route-id="@detalle.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-controller="DetallesCarrito" asp-action="Delete" asp-route-id="@detalle.Id" class="btn btn-sm btn-outline-danger">Quitar</a></td></tr>
        }
        </tbody>
    </table></div>
    <div class="d-flex flex-wrap justify-content-between gap-3 my-4">
        <span>@Model.Detalles.Sum(d => (long)d.Cantidad) unidades</span>
        <strong class="h5">Total estimado: Bs @Model.Detalles.Sum(d => d.Producto.Precio * d.Cantidad).ToString("F2")</strong>
    </div>
    @if (Model.Estado == "activo")
    {
        <section class="border rounded-3 p-3 mb-4">
            <h2 class="h5">Confirmar pedido</h2>
            <p>Se guardarán los productos con sus precios actuales y se vaciará este carrito para reutilizarlo. El stock se administra manualmente desde Productos.</p>
            <form asp-action="CrearPedido" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">Confirmar y crear pedido</button>
            </form>
        </section>
    }
    else
    {
        <div class="alert alert-warning">Activa el carrito desde Editar antes de crear un pedido.</div>
    }
}
<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar carrito</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a carritos</a>
</div>
